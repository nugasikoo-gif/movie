# Prevent script execution in uploads directory
# This protects against malicious file uploads

# Disable PHP execution
<FilesMatch "\.php$">
    SetHandler default-handler
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable CGI execution
Options -ExecCGI

# Prevent directory listing
Options -Indexes

# Only allow image files to be served
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Deny everything else
<FilesMatch "^\.htaccess$">
    Order Allow,Deny
    Deny from all
</FilesMatch>